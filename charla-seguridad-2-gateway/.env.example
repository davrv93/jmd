# Todo es opcional. Copia este archivo a .env solo si quieres cambiar algo.
# Sin .env, la demo arranca sola y genera sus secretos en memoria.

# Puertos en 127.0.0.1
PUERTO_PANEL=4810
PUERTO_DIRECTO=4811
PUERTO_GATEWAY=4812

# Clave de los usuarios de demo. Vacía = se genera una al arrancar y sale en la terminal.
# No pongas aquí ninguna clave que uses en otro lado.
CLAVE_DEMO=

# Límite de peticiones por sesión y ventana en milisegundos
LIMITE_SESION=20
VENTANA_LIMITE_MS=10000

# Tiempo máximo que puede tener una petición para ser aceptada
VENTANA_PETICION_MS=30000

# Cada cuánto rota la ruta dinámica de una sesión
VENTANA_RUTA_MS=60000
