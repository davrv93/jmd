# Copia a .env y rellena. Nunca subas .env al repo.

# Token de la UI (/ui/) y de /admin/api. Si lo dejas vacío se genera uno y queda en data/admin_token.
ADMIN_TOKEN=

# Claves que tu aplicación usa contra /v1 (separadas por comas). Vacío = sin autenticación (solo local).
GATEWAY_API_KEYS=

# Claves de los proveedores (también se pueden poner desde la UI).
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Puerto local publicado por compose.
AIO_PORT=4000

# --- LMS (lms/) ---------------------------------------------------------------
LMS_ADMIN_EMAIL=
LMS_ADMIN_PASSWORD=
LMS_ADMIN_NAME=Instructor
LMS_INVITE_CODE=
LMS_COHORT=cohorte-2026-2
LMS_PUBLIC_URL=http://localhost:8080
LMS_PORT=8080
OIDC_ISSUER=
OIDC_CLIENT_ID=lms-web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=lms-api

# Runner de código del LMS: WITH_RUNNER=1 instala el cliente docker en la imagen (y hay que
# descomentar el montaje del socket en compose.yaml). Déjalo en 0 salvo que uses el runner.
WITH_RUNNER=0
LMS_RUNNER=
LMS_RUNNER_TIMEOUT=15s
