      "html": "<div class=\"ds-empty\"><span class=\"ds-empty-ico\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/></svg></span><b>Sin clases</b><p>No hay sesiones programadas.</p></div>",
      "css": ".ds-empty{display:grid;justify-items:center;text-align:center;gap:.35rem;padding:2rem 1rem;border:1px dashed var(--line2,rgba(60,52,140,.24));border-radius:14px;color:var(--muted,#5c5966)}.ds-empty b{color:var(--fg,#16151d)}.ds-empty p{margin:0;font-size:.9rem}.ds-empty-ico{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--s2,#f4f3fb);color:var(--accent,#5a49d6)}"
