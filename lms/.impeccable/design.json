      "css": ".ds-tabs{display:flex;gap:.1rem;border-bottom:1px solid var(--line,rgba(60,52,140,.13))}.ds-tab{display:inline-flex;align-items:center;gap:.4rem;font:inherit;font-size:.9rem;font-weight:550;padding:.6rem .8rem;background:none;border:0;border-bottom:2px solid transparent;color:var(--muted,#5c5966);cursor:pointer;margin-bottom:-1px}.ds-tab:hover{color:var(--fg,#16151d)}.ds-tab.on{color:var(--accent,#5a49d6);border-bottom-color:var(--accent,#5a49d6)}.ds-tab:focus-visible{outline:2px solid var(--accent,#5a49d6);outline-offset:2px}.ds-count{font-size:.7rem;padding:0 .4rem;border-radius:999px;background:var(--accent-bg,rgba(90,73,214,.11));color:var(--accent,#5a49d6)}"
