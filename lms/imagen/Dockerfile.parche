# Parche rápido del servicio de imagen para la nube del kit robo-local-nube: parte de la imagen que YA corre en
# el servidor (con torch, diffusers y Piper) y solo cambia el código. No baja nada pesado ni depende de la caché.
#   sudo docker tag jmd/imagen:latest jmd/imagen:antes-nube
#   sudo docker build -f lms/imagen/Dockerfile.parche -t jmd/imagen:latest lms/imagen
FROM jmd/imagen:antes-nube
COPY app.py nube.py test_app.py /app/
