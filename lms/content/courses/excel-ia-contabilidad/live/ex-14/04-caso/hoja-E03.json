as para cubrirlos (cobrar antes, postergar, financiar).",5],["B21","Datos 100 % ficticios para capacitación. El RUC empieza con 99: no existe en SUNAT.",1]],"t":[]},{"n":"Flujo","dim":[8,24],"w":{"A":3.0,"B":36.0,"C":14.0,"D":14.0,"E":14.0,"F":14.0,"G":14.0,"H":14.0},"fz":null,"c":[["A1","Flujo de caja proyectado · Contables Pacífico",0],["B3","Caja mínima de seguridad:",6],["C3",21860.56,7],["B5","Concepto",8],["C5","Nov 2026",9],["D5","Dic 2026",9],["E5","Ene 2027",9],["F5","Feb 2027",9],["G5","Mar 2027",9],["H5","Abr 2027",9],["B6","Saldo inicial",2],["C6",65581.67,10],["D6",null,11],["E6",null,11],["F6",null,11],["G6",null,11],["H6",null,11],["B7","INGRESOS",12],["B8","Cobranzas de ventas",6],["C8",109302.78,13],["D8",136628.47,13],["E8",87442.22,13],["F8",92907.36,13],["G8",103837.64,13],["H8",109302.78,13],["B9","Otros ingresos",6],["C9",2186.06,13],["D9",2186.06,13],["E9",0,13],["F9",2186.06,13],["G9",2186.06,13],["H9",2186.06,13],["B10","Total ingresos",2],["C10",null,11],["D10",null,11],["E10",null,11],["F10",null,11],["G10",null,11],["H10",null,11],["B11","EGRESOS",12],["B12","Pago a proveedores",6],["C12",60116.53,13],["D12",75145.66,13],["E12",48093.22,13],["F12",51099.05,13],["G12",57110.7,13],["H12",60116.53,13],["B13","Planilla y EsSalud",6],["C13",19674.5,13],["D13",39349,13],["E13",19674.5,13],["F13",19674.5,13],["G13",19674.5,13],["H13",19674.5,13],["B14","Alquiler y servicios",6],["C14",8744.22,13],["D14",8744.22,13],["E14",8744.22,13],["F14",8744.22,13],["G14",8744.22,13],["H14",8744.22,13],["B15","Impuestos (IGV y renta)",6],["C15",5465.14,13],["D15",6011.65,13],["E15",7104.68,13],["F15",4372.11,13],["G15",4372.11,13],["H15",4918.63,13],["B16","Cuota de préstamo",6],["C16",6558.17,13],["D16",6558.17,13],["E16",6558.17,13],["F16",6558.17,13],["G16",6558.17,13],["H16",6558.17,13],["B17","Compra de activo fijo",6],["C17",0,13],["D17",0,13],["E17",60116.53,13],["F17",0,13],["G17",0,13],["H17",0,13],["B18","Total egresos",2],["C18",null,11],["D18",nu