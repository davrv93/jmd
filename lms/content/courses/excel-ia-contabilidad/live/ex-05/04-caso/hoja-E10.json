19","Esta es mi planilla de octubre. Revisa que la asignación familiar solo esté en quienes tienen hijos, que la tasa de pensión venga de la hoja Tasas y que el neto sea total menos descuentos. Señálame cualquier fila rara.",5],["B21","Datos 100 % ficticios para capacitación. El RUC empieza con 99: no existe en SUNAT.",1]],"t":[]},{"n":"Planilla","dim":[16,22],"w":{"A":13.0,"B":28.0,"C":24.0,"D":16.0,"E":13.0,"F":13.0,"G":13.0,"H":13.0,"I":15.0,"J":13.0,"K":14.0,"L":14.0,"M":14.0,"N":3.0,"O":28.0,"P":16.0},"fz":[2,4],"c":[["A1","Planilla · octubre 2026 · Agro Valle Verde",0],["A2","Asignación familiar (10 % RMV):",6],["C2",123,7],["E2","Tasa EsSalud:",6],["F2",0.09,8],["A4","Cód.",9],["B4","Trabajador",9],["C4","Cargo",9],["D4","Sistema de pensión",9],["E4","Hijos",9],["F4","Básico",9],["G4","Bono",9],["H4","Asig. familiar",10],["I4","Total remuneración",10],["J4","Tasa pensión",10],["K4","Descuento pensión",10],["L4","Neto a pagar",10],["M4","EsSalud (empresa)",10],["A5","T01",11],["B5","Jorge Salazar Vargas",11],["C5","Gerente general",11],["D5","ONP",11],["E5",2,11],["F5",6500,12],["G5",0,12],["H5",null,13],["I5",null,13],["J5",null,14],["K5",null,13],["L5",null,13],["M5",null,13],["O5","Total remuneraciones",15],["P5",null,16],["A6","T02",11],["B6","Teresa Paredes Vargas",11],["C6","Contador(a)",11],["D6","AFP Prima",11],["E6",3,11],["F6",3850,12],["G6",0,12],["H6",null,13],["I6",null,13],["J6",null,14],["K6",null,13],["L6",null,13],["M6",null,13],["O6","Total descuentos de pensión",15],["P6",null,16],["A7","T03",11],["B7","Patricia Ríos Rojas",11],["C7","Jefe(a) de campo",11],["D7","AFP Profuturo",11],["E7",0,11],["F7",3600,12],["G7",0,12],["H7",null,13],["I7",null,13],["J7",null,14],["K7",null,13],["L7",null,13],["M7",null,13],["O7","Total neto a pagar",15],["P7",null,16],["A8","T04",11],["B8","Víctor Espinoza Palomino",11],["C8","Ingeniero(a) agrónomo(a)",11],["D8","ONP",11],["E8",1,11],["F8",5250,12],["G8",0,12],["H8",null,13],["I8",null,13],["J8",null,14],[