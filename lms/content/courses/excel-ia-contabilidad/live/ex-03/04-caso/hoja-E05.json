qué un mes salió a pagar y otro no.",5],["B21","Datos 100 % ficticios para capacitación. El RUC empieza con 99: no existe en SUNAT.",1]],"t":[]},{"n":"Ventas","dim":[7,76],"w":{"A":13.0,"B":13.0,"C":15.0,"D":30.0,"E":13.0,"F":15.0,"G":13.0},"fz":null,"c":[["A1","Ventas agosto – octubre 2026",0],["A4","Mes",6],["B4","Fecha",6],["C4","Serie-Número",6],["D4","Cliente",6],["E4","Operación",6],["F4","Valor de venta",6],["G4","IGV",6],["A5",8,7],["B5",46235,8],["C5","F001-000397",7],["D5","Minera de práctica S.A.",7],["E5","Gravada",7],["F5",11760,9],["G5",2116.8,9],["A6",8,7],["B6",46235,8],["C6","F001-000398",7],["D6","Agroindustrias Ica",7],["E6","Gravada",7],["F6",8120,9],["G6",1461.6,9],["A7",8,7],["B7",46236,8],["C7","F001-000399",7],["D7","Ferreyros de práctica",7],["E7","Gravada",7],["F7",10374,9],["G7",1867.32,9],["A8",8,7],["B8",46237,8],["C8","F001-000400",7],["D8","Cementos del Centro",7],["E8","Gravada",7],["F8",10374,9],["G8",1867.32,9],["A9",8,7],["B9",46239,8],["C9","F001-000401",7],["D9","Cementos del Centro",7],["E9","Gravada",7],["F9",17052,9],["G9",3069.36,9],["A10",8,7],["B10",46241,8],["C10","B001-002905",7],["D10","Cliente con DNI",7],["E10","Gravada",7],["F10",3724,9],["G10",670.32,9],["A11",8,7],["B11",46242,8],["C11","F001-000402",7],["D11","Textil Arequipa",7],["E11","Gravada",7],["F11",8120,9],["G11",1461.6,9],["A12",8,7],["B12",46244,8],["C12","F001-000403",7],["D12","Textil Arequipa",7],["E12","Gravada",7],["F12",7714,9],["G12",1388.52,9],["A13",8,7],["B13",46246,8],["C13","F001-000404",7],["D13","Retail Perú SAC",7],["E13","Gravada",7],["F13",8526,9],["G13",1534.68,9],["A14",8,7],["B14",46246,8],["C14","F001-000405",7],["D14","Cementos del Centro",7],["E14","Gravada",7],["F14",8120,9],["G14",1461.6,9],["A15",8,7],["B15",46246,8],["C15","F001-000406",7],["D15","Ferreyros de práctica",7],["E15","Gravada",7],["F15",126,9],["G15",22.68,9],["A16",8,7],["B16",46248,8],["C16","F001-000407",7],["D16","Textil Arequipa",7],["E16","Gravada",7],["F16",1