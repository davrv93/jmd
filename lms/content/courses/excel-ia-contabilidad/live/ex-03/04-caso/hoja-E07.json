un mes salió a pagar y otro no.",5],["B21","Datos 100 % ficticios para capacitación. El RUC empieza con 99: no existe en SUNAT.",1]],"t":[]},{"n":"Ventas","dim":[7,76],"w":{"A":13.0,"B":13.0,"C":15.0,"D":30.0,"E":13.0,"F":15.0,"G":13.0},"fz":null,"c":[["A1","Ventas agosto – octubre 2026",0],["A4","Mes",6],["B4","Fecha",6],["C4","Serie-Número",6],["D4","Cliente",6],["E4","Operación",6],["F4","Valor de venta",6],["G4","IGV",6],["A5",8,7],["B5",46236,8],["C5","B001-002905",7],["D5","Cliente con DNI",7],["E5","Gravada",7],["F5",376.2,9],["G5",67.72,9],["A6",8,7],["B6",46236,8],["C6","B001-002906",7],["D6","Cliente con DNI",7],["E6","Gravada",7],["F6",352,9],["G6",63.36,9],["A7",8,7],["B7",46237,8],["C7","B001-002907",7],["D7","Cliente con DNI",7],["E7","Gravada",7],["F7",5720,9],["G7",1029.6,9],["A8",8,7],["B8",46238,8],["C8","F001-000397",7],["D8","Empresa Minera Sur (convenio)",7],["E8","Gravada",7],["F8",440,9],["G8",79.2,9],["A9",8,7],["B9",46239,8],["C9","F001-000398",7],["D9","Pacientes corporativos",7],["E9","Gravada",7],["F9",99,9],["G9",17.82,9],["A10",8,7],["B10",46243,8],["C10","F001-000399",7],["D10","Pacientes corporativos",7],["E10","Gravada",7],["F10",2145,9],["G10",386.1,9],["A11",8,7],["B11",46247,8],["C11","B001-002908",7],["D11","Cliente con DNI",7],["E11","Gravada",7],["F11",1056,9],["G11",190.08,9],["A12",8,7],["B12",46247,8],["C12","B001-002909",7],["D12","Cliente con DNI",7],["E12","Gravada",7],["F12",264,9],["G12",47.52,9],["A13",8,7],["B13",46247,8],["C13","B001-002910",7],["D13","Cliente con DNI",7],["E13","Gravada",7],["F13",679.25,9],["G13",122.27,9],["A14",8,7],["B14",46248,8],["C14","F001-000400",7],["D14","Colegio Santa María (convenio)",7],["E14","Gravada",7],["F14",1584,9],["G14",285.12,9],["A15",8,7],["B15",46248,8],["C15","F001-000401",7],["D15","Colegio Santa María (convenio)",7],["E15","Gravada",7],["F15",103.95,9],["G15",18.71,9],["A16",8,7],["B16",46250,8],["C16","B001-002911",7],["D16","Cliente con DNI",7],["E16","Gravada",7],["F1