def nombres(x):
    return ", ".join(str(r.get("id") or r.get("nombre") or r) if isinstance(r, dict) else str(r) for r in (x or []))
print("Sistemas de práctica (elige uno con: aula sistema <id>)\n")
print("%-16s %-30s %s" % ("id", "rubro", "roles"))
for s in d:
