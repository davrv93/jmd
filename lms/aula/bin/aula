#!/bin/sh
# aula: arranque del asistente del alumno dentro de su contenedor.
# Uso: aula iniciar | parar | estado | nuevo <plantilla> | paso | whatsapp | db | sistema [id|foto] | dsh [clave|olvidar|web|estado|"tarea"]
# (el LMS usa además «aula dsh clave -», «aula dsh rele -|borrar», «aula dsh modo» y «aula dsh abrir»: botón «Abrir DeepSeek Harness»)
PID=/tmp/osito.pid
vivo() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

# ---- DeepSeek Harness (aula dsh) -------------------------------------------------------------------------------
# La clave vive SOLO en $HOME/.aula-dsh/clave (0600, dentro del tmpfs del home: se pierde al reiniciar el aula).
# Nunca en /trabajo: el Visor sirve /trabajo como archivos estáticos. aula la lee y la pone en el entorno del
# proceso hijo (DEEPSEEK_API_KEY); no sale en la línea de comandos ni en pantalla. dsh headless solo lee la clave
# del entorno / .env (ignora la guardada en Ajustes), así que este camino sirve igual para la CLI y para la web.
DSH_DIR="$HOME/.aula-dsh"
DSH_CLAVE="$DSH_DIR/clave"
DSH_PID=/tmp/aula-dsh-web.pid
DSH_LOG=/tmp/aula-dsh-web.log
DSH_URLF=/tmp/aula-dsh-web.url
DSH_PUERTO=3080
DSH_PARCHE=/opt/dsh-aula.patch.yml
DSH_USO=/usr/local/lib/aula-dsh-uso.mjs
# Relé de la clase (botón «Abrir DeepSeek Harness» del LMS, grupos con clave de la clase): el LMS deja aquí un TOKEN
# de esta aula y la URL de su relé. NO es la clave de DeepSeek de la clase: esa vive solo en el LMS, que la añade al
# reenviar. El token caduca cuando el aula se apaga o se recrea, y tiene tope diario. 0600 en el tmpfs del home.
DSH_RELE="$DSH_DIR/rele"
# Huella (sha256 cortado) de la credencial con que arrancó «dsh web»: si cambia (clave nueva, otro token), el
# siguiente «aula dsh web» la reinicia sola. Nunca guarda la clave, solo su huella.
DSH_FIRMAF=/tmp/aula-dsh-web.firma

dsh_espacio() { if [ -d /trabajo/sistema ]; then echo /trabajo/sistema; else echo /trabajo; fi; }
dsh_vivo() { [ -f "$DSH_PID" ] && kill -0 "$(cat "$DSH_PID")" 2>/dev/null; }

dsh_listo() {
  if command -v dsh >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then return 0; fi
  echo "Esta aula no trae dsh (falta Node o dsh en la imagen). Cierra la terminal y vuelve a entrar al LIVE: el aula se renueva sola." >&2
  echo "Si sigue igual, avisa al instructor." >&2
  return 1
}

# Imprime la clave por stdout para capturarla con $(...); nunca la mandes a pantalla.
dsh_clave_valor() {
  if [ -n "${DEEPSEEK_API_KEY:-}" ]; then printf '%s' "$DEEPSEEK_API_KEY"; return 0; fi
  if [ -r "$DSH_CLAVE" ]; then
    IFS= read -r dsh_k < "$DSH_CLAVE" || true
    if [ -n "$dsh_k" ]; then printf '%s' "$dsh_k"; return 0; fi
  fi
  return 1
}

# Credencial con la que corre dsh, por prioridad: la clave propia del alumno (entorno o ~/.aula-dsh/clave) y, si no
# hay, el relé de la clase (~/.aula-dsh/rele). Deja dsh_modo (propia|global), dsh_kk (lo que va en DEEPSEEK_API_KEY)
# y dsh_base (DEEPSEEK_BASE_URL; vacía = la API pública de DeepSeek). Devuelve 1 si no hay ninguna.
dsh_credencial() {
  dsh_modo=""; dsh_kk=""; dsh_base=""
  if dsh_kk=$(dsh_clave_valor); then dsh_modo=propia; return 0; fi
  if [ -r "$DSH_RELE" ]; then
    { IFS= read -r dsh_kk; IFS= read -r dsh_base; } < "$DSH_RELE" || true
    if [ -n "$dsh_kk" ] && [ -n "$dsh_base" ]; then dsh_modo=global; return 0; fi
  fi
  dsh_kk=""; dsh_base=""
  return 1
}

# Exporta la credencial al entorno del proceso hijo (llamar dentro de un subshell).
dsh_exportar() {
  export DEEPSEEK_API_KEY="$dsh_kk" DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
  if [ -n "$dsh_base" ]; then
    # dsh habla la Messages API (compatible con Anthropic): POST <base>/v1/messages y <base>/v1/files.
    # La búsqueda web va aparte (DEEPSEEK_SEARCH_BASE_URL, ya con /v1).
    export DEEPSEEK_BASE_URL="$dsh_base" DEEPSEEK_SEARCH_BASE_URL="${dsh_base%/}/v1"
    # El relé es el propio LMS: si está en la red del aula (NO_PROXY), va directo; si no, por el proxy de la clase.
  else
    unset DEEPSEEK_BASE_URL DEEPSEEK_SEARCH_BASE_URL
  fi
}

dsh_firma() { printf '%s\n%s\n%s' "$dsh_modo" "$dsh_kk" "$dsh_base" | sha256sum | cut -c1-16; }

# Guarda la clave propia ($1, ya limpia). Comprueba el formato; 0600 en el tmpfs del home.
dsh_guardar_clave() {
  dsh_k=$(printf '%s' "$1" | tr -d '[:space:]')
  dsh_k=${dsh_k#DEEPSEEK_API_KEY=}
  if [ -z "$dsh_k" ]; then echo "No escribiste nada. Vuelve a correr: aula dsh clave" >&2; dsh_k=""; return 1; fi
  case "$dsh_k" in
    *[!A-Za-z0-9._-]*) echo "Esa clave tiene caracteres raros (¿pegaste comillas o texto de más?). Vuelve a correr: aula dsh clave" >&2; dsh_k=""; return 1 ;;
  esac
  case "$dsh_k" in sk-*) ;; *) echo "Aviso: las claves de DeepSeek empiezan por «sk-»; la guardo igual." >&2 ;; esac
  ( umask 077; mkdir -p "$DSH_DIR" && printf '%s\n' "$dsh_k" > "$DSH_CLAVE" ) || { echo "No pude guardar la clave en $DSH_DIR." >&2; dsh_k=""; return 1; }
  chmod 700 "$DSH_DIR" 2>/dev/null; chmod 600 "$DSH_CLAVE" 2>/dev/null
  dsh_k=""
  return 0
}

# «aula dsh clave -»: la clave llega por stdin (el LMS la escribe así: nunca en la línea de comandos).
dsh_clave_stdin() {
  IFS= read -r dsh_k || [ -n "${dsh_k:-}" ] || dsh_k=""
  dsh_guardar_clave "$dsh_k" || { dsh_k=""; return 1; }
  dsh_k=""
  echo "clave guardada"
}

# «aula dsh rele -»: dos líneas por stdin, el token de esta aula y la URL base del relé del LMS.
dsh_rele_guardar() {
  dsh_t=""; dsh_u=""
  IFS= read -r dsh_t || true
  IFS= read -r dsh_u || true
  case "$dsh_t" in ""|*[!A-Za-z0-9._-]*) echo "token del relé no válido" >&2; return 1 ;; esac
  case "$dsh_u" in http://*|https://*) ;; *) echo "URL del relé no válida" >&2; return 1 ;; esac
  case "$dsh_u" in *[!A-Za-z0-9._~:/%-]*) echo "URL del relé no válida" >&2; return 1 ;; esac
  ( umask 077; mkdir -p "$DSH_DIR" && printf '%s\n%s\n' "$dsh_t" "$dsh_u" > "$DSH_RELE" ) || return 1
  chmod 700 "$DSH_DIR" 2>/dev/null; chmod 600 "$DSH_RELE" 2>/dev/null
  dsh_t=""
  echo "relé guardado"
}

# «aula dsh modo»: qué credencial usaría dsh (propia|global|ninguna) y si la web está arrancada. Sin secretos.
dsh_modo_ver() {
  if dsh_credencial; then dsh_m=$dsh_modo; else dsh_m=ninguna; fi
  dsh_kk=""
  if dsh_vivo; then echo "$dsh_m arrancada"; else echo "$dsh_m parada"; fi
}

dsh_pedir_clave() {
  if [ ! -t 0 ]; then
    echo "Necesito una terminal para pedirte la clave sin que se vea. Ábrela en el panel Terminal y corre: aula dsh clave" >&2
    return 1
  fi
  # El eco se apaga ANTES del aviso: si no, una clave pegada justo al salir el aviso se vería (medido en el e2e).
  dsh_old=$(stty -g 2>/dev/null) || dsh_old=""
  if [ -n "$dsh_old" ]; then
    stty -echo 2>/dev/null
    trap 'stty "$dsh_old" 2>/dev/null; echo >&2; exit 130' INT TERM
  fi
  printf 'Pega tu API key de DeepSeek (no se ve al escribir) y pulsa Enter: ' >&2
  IFS= read -r dsh_k || dsh_k=""
  if [ -n "$dsh_old" ]; then stty "$dsh_old" 2>/dev/null; trap - INT TERM; fi
  echo >&2
  dsh_guardar_clave "$dsh_k" || { dsh_k=""; return 1; }
  dsh_k=""
  echo "Clave guardada para esta aula (solo en memoria del aula: se pierde si se reinicia; nunca va a /trabajo)."
  if dsh_vivo; then echo "La interfaz web ya estaba arrancada con la clave anterior: «aula dsh web» la reinicia con la nueva."; fi
  echo "Siguiente paso: aula dsh \"describe tu tarea\"   o   aula dsh web"
}

dsh_olvidar() {
  rm -f "$DSH_CLAVE" 2>/dev/null
  echo "Clave borrada de esta aula."
  # Si la web corría con esa clave, se para: así la clave sale también de su memoria.
  if dsh_vivo && [ "$(cat /tmp/aula-dsh-web.modo 2>/dev/null)" = propia ]; then dsh_web_parar >/dev/null; echo "La interfaz web de dsh se paró (usaba esa clave)."; fi
}

dsh_diagnostico() {
  # $1 = archivo con el stderr de dsh
  if grep -q -E 'AUTH|401|Authentication' "$1" 2>/dev/null; then
    echo "DeepSeek rechazó tu clave (401). Revisa que esté completa y vigente; para cambiarla: aula dsh clave" >&2
  elif grep -q -i -E 'ENOTFOUND|ECONNREFUSED|ETIMEDOUT|ECONNRESET|fetch failed|proxy|network|socket' "$1" 2>/dev/null; then
    echo "No hubo salida a internet por el proxy de la clase (HTTPS_PROXY=${HTTPS_PROXY:-sin definir}). Avisa al instructor." >&2
  elif grep -q -E '402|Insufficient|balance' "$1" 2>/dev/null; then
    echo "Tu cuenta de DeepSeek no tiene saldo (402). Recarga saldo en platform.deepseek.com." >&2
  fi
  grep '^dsh:' "$1" 2>/dev/null | head -n 3 >&2
}

# Una tarea headless; suma su uso al archivo de totales $DSH_TOT si existe esa variable.
dsh_tarea() {
  dsh_listo || return 1
  dsh_credencial || { echo "Aún no me diste tu clave de DeepSeek. Primero: aula dsh clave" >&2; return 1; }
  dsh_ws=$(dsh_espacio)
  # El selector de carpetas de dsh web empieza en el home (tmpfs vacío): el enlace hace que aparezca «trabajo».
  [ -e "$HOME/trabajo" ] || ln -s /trabajo "$HOME/trabajo" 2>/dev/null
  dsh_err=$(mktemp /tmp/aula-dsh-err.XXXXXX) || return 1
  dsh_st=$(mktemp /tmp/aula-dsh-st.XXXXXX) || return 1
  echo "dsh trabaja en $dsh_ws … (puede tardar un minuto; Ctrl+C para cancelar)" >&2
  (
    cd "$dsh_ws" || exit 1
    dsh_exportar
    dsh --profile headless --patch "$DSH_PARCHE" --json "$1" 2>"$dsh_err"
    echo $? > "$dsh_st"
  ) | node "$DSH_USO" "${DSH_TOT:-}"
  dsh_kk=""
  dsh_rc=$(cat "$dsh_st" 2>/dev/null); dsh_rc=${dsh_rc:-1}
  if [ "$dsh_rc" != 0 ]; then dsh_diagnostico "$dsh_err"; fi
  rm -f "$dsh_err" "$dsh_st"
  return "$dsh_rc"
}

dsh_interactivo() {
  dsh_listo || return 1
  dsh_credencial || { echo "Aún no me diste tu clave de DeepSeek. Primero: aula dsh clave" >&2; return 1; }
  dsh_kk=""
  DSH_TOT=$(mktemp /tmp/aula-dsh-uso.XXXXXX) || return 1
  rm -f "$DSH_TOT"
  export DSH_TOT
  echo "dsh (modo simple) en $(dsh_espacio). Cada línea es una tarea NUEVA e independiente (no recuerda la anterior)."
  echo "Escribe «salir» (o Ctrl+D) para terminar; al salir verás el uso total de la sesión."
  while printf 'dsh> ' >&2 && IFS= read -r dsh_linea; do
    case "$dsh_linea" in
      salir|exit|quit|:q) break ;;
      *[![:space:]]*) dsh_tarea "$dsh_linea" || true ;;
    esac
  done
  echo
  node "$DSH_USO" --total "$DSH_TOT"
  rm -f "$DSH_TOT"
}

dsh_web_url() { if [ -s "$DSH_URLF" ]; then cat "$DSH_URLF"; fi; }

dsh_estado() {
  if command -v dsh >/dev/null 2>&1; then echo "dsh:        $(dsh --version 2>/dev/null) (Node $(node -v 2>/dev/null))"; else echo "dsh:        no está en esta imagen"; fi
  if dsh_credencial; then
    if [ "$dsh_modo" = propia ]; then echo "clave:      la tuya, guardada (no se muestra)"; else echo "clave:      la de la clase, por el relé del LMS ($dsh_base)"; fi
  else echo "clave:      falta  ->  aula dsh clave"; fi
  dsh_kk=""
  echo "espacio:    $(dsh_espacio)"
  if [ -n "${HTTPS_PROXY:-}" ]; then echo "internet:   por el proxy de la clase ($HTTPS_PROXY)"; else echo "internet:   SIN proxy definido (HTTPS_PROXY): dsh no podrá llegar a DeepSeek"; fi
  if dsh_vivo; then
    echo "web:        arrancada (pid $(cat "$DSH_PID"))"
    echo "enlace:     $(dsh_web_url)"
  elif [ -n "${AULA_DSH_URL:-}" ]; then
    echo "web:        parada  ->  aula dsh web"
  else
    echo "web:        no disponible en esta aula (faltan AULA_DSH_URL y AULA_DSH_HOST); usa la terminal: aula dsh \"tarea\""
  fi
}

dsh_web_parar() {
  if dsh_vivo; then
    dsh_p=$(cat "$DSH_PID")
    kill "$dsh_p" 2>/dev/null
    dsh_n=0; while kill -0 "$dsh_p" 2>/dev/null && [ "$dsh_n" -lt 20 ]; do dsh_n=$((dsh_n+1)); sleep 0.25; done
    kill -9 "$dsh_p" 2>/dev/null
    echo "interfaz web de dsh parada"
  else
    echo "la interfaz web de dsh no estaba arrancada"
  fi
  rm -f "$DSH_PID" "$DSH_URLF" "$DSH_FIRMAF" /tmp/aula-dsh-web.modo
}

dsh_web() {
  dsh_listo || return 1
  if [ -z "${AULA_DSH_URL:-}" ] || [ -z "${AULA_DSH_HOST:-}" ]; then
    echo "Esta aula no tiene la interfaz web de dsh (faltan AULA_DSH_URL y AULA_DSH_HOST)." >&2
    echo "Cierra la terminal y vuelve a entrar al LIVE: el aula se renueva sola. Si sigue igual, avisa al instructor." >&2
    echo "Mientras tanto puedes usar dsh en la terminal: aula dsh \"tu tarea\"" >&2
    return 1
  fi
  # Un solo arranque a la vez (la terminal y el visor pueden pedirlo juntos).
  dsh_n=0; until mkdir /tmp/.aula-dsh-web 2>/dev/null; do dsh_n=$((dsh_n+1)); [ "$dsh_n" -gt 60 ] && { rmdir /tmp/.aula-dsh-web 2>/dev/null; break; }; sleep 0.5; done
  trap 'rmdir /tmp/.aula-dsh-web 2>/dev/null' EXIT
  dsh_credencial || { echo "Aún no me diste tu clave de DeepSeek. Primero: aula dsh clave  (y luego aula dsh web)" >&2; return 3; }
  dsh_f=$(dsh_firma)
  if dsh_vivo; then
    if [ "$(cat "$DSH_FIRMAF" 2>/dev/null)" = "$dsh_f" ] && [ -s "$DSH_URLF" ]; then
      dsh_kk=""
      echo "La interfaz web de dsh ya estaba arrancada. Ábrela con este enlace (no lo compartas):"
      echo "  $(dsh_web_url)"
      return 0
    fi
    # Arrancó con otra credencial (clave nueva, otro token del relé): se reinicia con la actual.
    echo "La interfaz web de dsh corría con otra clave: la reinicio con la actual."
    dsh_web_parar >/dev/null
  fi
  rm -f "$DSH_PID" "$DSH_URLF" "$DSH_FIRMAF"
  # Solo en 127.0.0.1: el LMS llega por «exec nc 127.0.0.1 3080» dentro del aula (Aula.Dial), no por la red.
  # En la IP del contenedor el LMS no lo alcanzaba (502) y las demás aulas de la misma red sí veían el puerto.
  dsh_ip=127.0.0.1
  dsh_ws=$(dsh_espacio)
  ( umask 077; : > "$DSH_LOG" )
  (
    cd "$dsh_ws" || exit 1
    dsh_exportar
    exec nohup dsh --profile web --patch "$DSH_PARCHE" --no-open --port "$DSH_PUERTO" --host "$dsh_ip" \
      --public-url "$AULA_DSH_URL" --trusted-host "$AULA_DSH_HOST" </dev/null >> "$DSH_LOG" 2>&1
  ) &
  dsh_p=$!
  ( umask 077; echo "$dsh_p" > "$DSH_PID"; echo "$dsh_f" > "$DSH_FIRMAF"; echo "$dsh_modo" > /tmp/aula-dsh-web.modo )
  dsh_kk=""
  echo "Arrancando la interfaz web de dsh … (espacio de trabajo: $dsh_ws)"
  dsh_n=0; dsh_url=""
  while [ "$dsh_n" -lt 120 ]; do
    if ! kill -0 "$dsh_p" 2>/dev/null; then
      echo "dsh web se cerró al arrancar. Lo último que dijo:" >&2
      tail -n 8 "$DSH_LOG" >&2
      rm -f "$DSH_PID"
      return 1
    fi
    dsh_url=$(sed -n 's#^dsh web: \(https\{0,1\}://[^ ]*\)$#\1#p' "$DSH_LOG" | tail -n 1)
    if [ -n "$dsh_url" ] && [ "$(curl -s -o /dev/null -w '%{http_code}' "http://$dsh_ip:$DSH_PUERTO/" 2>/dev/null)" != 000 ]; then break; fi
    dsh_url=""; dsh_n=$((dsh_n+1)); sleep 0.5
  done
  if [ -z "$dsh_url" ]; then
    echo "dsh web no respondió en 60 s. Lo último que dijo:" >&2
    tail -n 8 "$DSH_LOG" >&2
    echo "Prueba: aula dsh web parar && aula dsh web   (si sigue igual, avisa al instructor)" >&2
    return 1
  fi
  ( umask 077; printf '%s\n' "$dsh_url" > "$DSH_URLF" )
  echo "Lista. Abre este enlace en tu navegador (lleva tu acceso; no lo compartas):"
  echo "  $dsh_url"
  echo "Para ver su estado: aula dsh estado · para pararla: aula dsh web parar"
}

# «aula dsh abrir»: lo que llama el botón del LMS. Arranca (o reutiliza, o reinicia si cambió la clave) la web y deja
# como ÚLTIMA línea «URL <enlace>». Código 3 = no hay clave ni relé. Los mensajes van a stderr.
dsh_abrir() {
  dsh_web >&2
  dsh_rc=$?
  [ "$dsh_rc" = 0 ] || return "$dsh_rc"
  [ -s "$DSH_URLF" ] || return 1
  echo "URL $(cat "$DSH_URLF")"
}

dsh_ayuda() {
  cat <<'AYUDA'
aula dsh clave            guarda tu API key de DeepSeek (se escribe sin eco; solo vive en la memoria del aula)
aula dsh olvidar          borra la clave del aula
aula dsh "tarea"          dsh hace la tarea en /trabajo/sistema (o /trabajo) y te da la respuesta y el uso de tokens
aula dsh                  modo simple: cada línea que escribas es una tarea (salir para terminar)
aula dsh web              arranca la interfaz web de dsh y te da el enlace para abrirla
aula dsh web parar        para la interfaz web
aula dsh estado           qué hay: versión, clave, internet, interfaz web
AYUDA
}

case "${1:-}" in
  iniciar)
    # Un solo «iniciar» a la vez: el visor y la terminal pueden pedirlo juntos y uno pisaría la copia del otro.
    n=0; until mkdir /tmp/.aula-iniciar 2>/dev/null; do n=$((n+1)); [ "$n" -gt 60 ] && { rmdir /tmp/.aula-iniciar 2>/dev/null; break; }; sleep 0.5; done
    trap 'rmdir /tmp/.aula-iniciar 2>/dev/null' EXIT
    if vivo; then echo "ya arrancado"; exit 0; fi
    # Huella del árbol del asistente (sin cachés, imágenes ni la propia marca).
    huella() { (cd "$1" && find . -type f ! -path './__pycache__/*' ! -path '*/__pycache__/*' ! -path './imagenes/*' ! -name .base ! -name '*.pyc' | sort | xargs sha256sum | sha256sum | cut -d' ' -f1); }
    if [ ! -d /trabajo/osito ]; then
      cp -R /opt/osito /trabajo/osito
      huella /opt/osito > /trabajo/osito/.base
    elif [ -f /trabajo/osito/.base ] && [ "$(cat /trabajo/osito/.base)" = "$(huella /trabajo/osito)" ] && [ "$(cat /trabajo/osito/.base)" != "$(huella /opt/osito)" ]; then
      # El alumno no lo tocó y la imagen trae una versión nueva: se actualiza sola.
      rm -rf /trabajo/osito && cp -R /opt/osito /trabajo/osito && huella /opt/osito > /trabajo/osito/.base
      echo "asistente actualizado a la versión nueva"
    fi
    # Página de entrada del visor: lleva al asistente. Si el alumno crea su propio index.html, manda el suyo.
    [ -e /trabajo/index.html ] || printf '%s' '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0; url=osito/frontend/index.html"><a href="osito/frontend/index.html">Abrir mi asistente</a>' > /trabajo/index.html
    cd /trabajo/osito || exit 1
    OSITO_PERFIL="${OSITO_PERFIL:-nube}" OSITO_PUERTO="${OSITO_PUERTO:-8766}" \
      /opt/venv/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port "${OSITO_PUERTO:-8766}" \
      >> /trabajo/osito.log 2>&1 &
    echo $! > "$PID"
    echo "arrancado"
    ;;
  parar)
    if vivo; then kill "$(cat "$PID")"; fi
    rm -f "$PID"
    echo "parado"
    ;;
  estado)
    if vivo; then echo "arrancado"; else echo "parado"; fi
    ;;
  nuevo)
    # aula nuevo <plantilla> [carpeta]: copia una plantilla a /trabajo sin pisar lo que ya existe.
    plantilla="${2:-}"
    [ -n "$plantilla" ] || { echo "uso: aula nuevo html|react-esm|vue-esm|preact-htm|php|python-static [carpeta]" >&2; exit 2; }
    [ -d "/opt/plantillas/$plantilla" ] || { echo "no existe la plantilla: $plantilla" >&2; exit 2; }
    destino="/trabajo/${3:-$plantilla}"
    if [ -e "$destino" ]; then echo "ya existe $destino; no se toca" >&2; exit 1; fi
    cp -R "/opt/plantillas/$plantilla" "$destino"
    echo "creado $destino"
    case "$plantilla" in
      php)
        if command -v php >/dev/null 2>&1; then
          (cd "$destino" && timeout 900 php -S 0.0.0.0:8767 >/dev/null 2>&1 &)
          echo "servidor en el puerto 8767 (se apaga solo en 15 min)"
        else
          echo "esta aula no trae PHP: usa la plantilla python-static o html" >&2
        fi ;;
      python-static)
        (cd "$destino" && timeout 900 python3 -m http.server 8767 >/dev/null 2>&1 &)
        echo "servidor en el puerto 8767 (se apaga solo en 15 min)" ;;
      *) echo "ábrela en el panel Visor: /vista/<tú>/$(basename "$destino")/" ;;
    esac
    ;;
  paso)
    # Clase 3 paso a paso: un comando por paso, el agente hace la tarea y se comprueba sola.
    shift; exec /usr/local/bin/aula-paso "$@"
    ;;
  whatsapp)
    # Estado de la instancia de WhatsApp del alumno y, si no está vinculada, el QR en /trabajo/qr.png.
    if [ -z "${EVO_URL:-}" ] || [ -z "${EVO_TOKEN:-}" ]; then
      echo "Tu aula no tiene WhatsApp configurado (faltan EVO_URL y EVO_TOKEN)." >&2
      echo "Cierra la terminal y vuelve a entrar al LIVE: el aula se renueva sola. Si sigue igual, avisa al instructor." >&2
      exit 1
    fi
    exec /opt/venv/bin/python - <<'PY'
import base64, json, os, sys, time, urllib.request, urllib.error

url, token = os.environ["EVO_URL"].rstrip("/"), os.environ["EVO_TOKEN"]
inst, webhook = os.environ.get("EVO_INSTANCE", "?"), os.environ.get("EVO_WEBHOOK", "")
qr_png = "/trabajo/qr.png"

def pedir(metodo, ruta, cuerpo=None, espera=20):
    datos = json.dumps(cuerpo).encode() if cuerpo is not None else None
    req = urllib.request.Request(url + ruta, data=datos, method=metodo,
                                 headers={"apikey": token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=espera) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        cuerpo = e.read().decode(errors="replace")[:200]
        if e.code in (401, 403, 404):
            sys.exit(f"Evolution Go no reconoce tu instancia ({e.code}): {cuerpo}\nAvisa al instructor.")
        sys.exit(f"Evolution Go respondió {e.code}: {cuerpo}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"Evolution Go no responde en {url}: {e}")

def estado():
    d = pedir("GET", "/instance/status").get("data") or {}
    return bool(d.get("Connected")), bool(d.get("LoggedIn")), d.get("Name") or ""

conectado, vinculado, nombre = estado()
print(f"instancia: {inst}")
print(f"conectada: {'sí' if conectado else 'no'} · vinculada: {'sí' if vinculado else 'no'}" + (f" · {nombre}" if nombre else ""))
print(f"webhook:   {webhook or '(sin EVO_WEBHOOK)'}")
# connect guarda el webhook; si la sesión ya corre, solo actualiza la configuración (no la reinicia).
pedir("POST", "/instance/connect", {"webhookUrl": webhook, "subscribe": ["MESSAGE"]})
if vinculado:
    print("Tu WhatsApp ya está vinculado. Los mensajes llegan a tu backend en el puerto 8766: POST /api/webhook")
    sys.exit(0)

def pintar(code):
    """El QR en la propia terminal (y una copia en /trabajo/qr.png para el Visor)."""
    try:
        import qrcode
        q = qrcode.QRCode(border=2, error_correction=qrcode.constants.ERROR_CORRECT_L)
        q.add_data(code)
        q.make(fit=True)
        sys.stdout.write("\033[2J\033[H")
        q.print_ascii(invert=True)
    except Exception as e:  # sin la librería: solo el PNG
        print(f"(no pude dibujar el QR aquí: {e}; ábrelo en el Visor: qr.png)")
    print(f"Instancia: {inst} · QR de las {time.strftime('%H:%M:%S')} (cambia cada ~20 s)")
    print("WhatsApp > Dispositivos vinculados > Vincular un dispositivo, y apunta la cámara aquí.")
    print("Si no entra, agranda la terminal (Pantalla completa) o abre qr.png en el Visor. Ctrl+C para salir.", flush=True)

# Ojo con el fork: pedir /instance/qr con la sesión YA vinculada reinicia el cliente y rompe el
# emparejamiento. Por eso se mira el estado cada 2 s y el QR solo se pide si NO está vinculado y el
# anterior ya tiene ~15 s.
ultimo, pedido, fin = None, 0.0, time.time() + 180
while time.time() < fin:
    if estado()[1]:
        print("\n¡Vinculado! Ya puedes recibir y enviar mensajes. Tus mensajes llegan a POST /api/webhook en el 8766.")
        try:
            os.remove(qr_png)
        except OSError:
            pass
        sys.exit(0)
    if time.time() - pedido >= 15 or ultimo is None:
        d = pedir("GET", "/instance/qr", espera=30).get("data") or {}
        pedido = time.time()
        code, png = d.get("code") or "", d.get("qrcode") or ""
        if png.startswith("data:image") and "," in png:
            with open(qr_png + ".tmp", "wb") as f:
                f.write(base64.b64decode(png.split(",", 1)[1]))
            os.replace(qr_png + ".tmp", qr_png)
        if code and code != ultimo:
            ultimo = code
            pintar(code)
    time.sleep(2)
print("El QR caducó sin escanearse. Vuelve a correr: aula whatsapp")
sys.exit(1)
PY
