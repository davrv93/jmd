# Copia a lms/.env (o añade a tu .env de la raíz). Nunca subas .env al repo.

# Cuenta del instructor (admin + instructor). Se crea al arrancar si no existe.
LMS_ADMIN_EMAIL=instructor@ejemplo.edu
LMS_ADMIN_PASSWORD=cambia-esta-clave
LMS_ADMIN_NAME=Instructor

# Código que das a tus alumnos para registrarse, y la cohorte en la que quedan.
LMS_INVITE_CODE=vibecoding-2026-2
LMS_COHORT=cohorte-2026-2

# URL pública (para los enlaces de las preguntas y la redirección del SSO).
LMS_PUBLIC_URL=http://localhost:8080
LMS_PORT=8080

# SSO con Keycloak (realm lms). Vacío = solo cuentas locales.
OIDC_ISSUER=
OIDC_CLIENT_ID=lms-web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=lms-api

# Runner de código (ejecuta los ejemplos de los alumnos). VACÍO = desactivado (recomendado por
# defecto): el LMS funciona igual, solo no ejecuta código. Para activarlo: pon docker|podman aquí,
# WITH_RUNNER=1 en el .env de la raíz (instala el cliente docker en la imagen) y descomenta el
# montaje del socket en compose.yaml. Acepta el riesgo: quien controle el socket controla el host.
LMS_RUNNER=
LMS_RUNNER_TIMEOUT=15s

# IA del Estudio: LMS_LLM_* son solo el valor inicial. Lo que se guarda en el panel del
# instructor (Instructor > Inteligencia artificial) manda y queda en la base del LMS.
# Estudio de landing: la terminal interactiva corre en un contenedor aislado (usa el mismo motor
# que el runner; necesita WITH_RUNNER=1 y el socket montado). LMS_TERM_IMAGE elige la imagen.
LMS_TERM_IMAGE=
# Generación con IA: endpoint OpenAI-compatible (el gateway). Vacío = el botón «Generar» avisa
# que no hay gateway y el alumno pega el HTML hecho con su OpenCode + el skill.
LMS_LLM_URL=
LMS_LLM_KEY=
LMS_LLM_MODEL=auto

# Modo LIVE: aula por alumno (ver lms/aula/README.md). LMS_AULA_MEMORIA vacío = 384m.
LMS_AULA_MEMORIA=

# Clase 3 (chatbot de WhatsApp: Bun + Elysia + PostgreSQL + Evolution Go). Perfil «clase» de compose.yaml:
#   docker compose --profile clase up -d --build aula-pg evogo-clase npm-proxy
# Vacías = las aulas se crean como siempre, sin DATABASE_URL ni EVO_*.
LMS_AULA_PG=aula-pg
LMS_EVO_URL=http://evogo-clase:8080
# GLOBAL_API_KEY de evogo-clase: vive SOLO en el LMS (nunca entra a un aula). Genera una: openssl rand -hex 24
LMS_EVO_KEY=
LMS_AULA_PROXY=http://npm-proxy:8888
# Semilla de las claves de Postgres y los tokens de WhatsApp de cada alumno. Vacía = aleatoria, guardada en
# el volumen lms_data (aula-secreto). Si cambia, hay que borrar las instancias viejas de evogo-clase.
LMS_AULA_SECRETO=
# Superusuario de aula-pg (el LMS no la usa: entra por el socket local) y rol de evolution-go.
# Se leen SOLO en el primer arranque del volumen aula_pg_data. openssl rand -hex 24 para cada una.
AULA_PG_PASSWORD=
EVOGO_DB_PASSWORD=
# Si evolution-go pide licencia (503 LICENSE_REQUIRED), el correo con el que se activó.
EVOLUTION_OPERATOR_EMAIL=
